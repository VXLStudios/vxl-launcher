{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "updater"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "dialog:default",
    "opener:allow-open-path",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image",
    "dialog:allow-open",
    "updater:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-create",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "process:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/vxl/**" },
        { "path": "$APPDATA/com.vxl.VXLLauncher/**" },
        { "path": "$APPCONFIG/vxl/**" },
        { "path": "$APPCONFIG/com.vxl.VXLLauncher/**" },
        { "path": "$APPLOCALDATA/vxl/**" },
        { "path": "$APPLOCALDATA/com.vxl.VXLLauncher/**" },
        { "path": "$APPCACHE/vxl/**" },
        { "path": "$APPCACHE/com.vxl.VXLLauncher/**" },
        { "path": "$APPLOG/vxl/**" },
        { "path": "$APPLOG/com.vxl.VXLLauncher/**" }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPDATA/vxl/**" },
        { "path": "$APPDATA/com.vxl.VXLLauncher/**" },
        { "path": "$APPCONFIG/vxl/**" },
        { "path": "$APPCONFIG/com.vxl.VXLLauncher/**" },
        { "path": "$APPLOCALDATA/vxl/**" },
        { "path": "$APPLOCALDATA/com.vxl.VXLLauncher/**" }
      ]
    }
  ]
}
